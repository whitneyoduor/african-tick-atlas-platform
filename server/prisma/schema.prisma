generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./tickatlas.db"
}

model Occurrence {
  id        Int     @id @default(autoincrement())
  gbifId    String? @unique
  species   String?
  latitude  Float?
  longitude Float?
  country   String?
  year      Int?
  citation  String?

  @@index([species])
  @@index([country])
  @@map("occurrences")
}

model EpidemiologicalRecord {
  id                        Int      @id @default(autoincrement())
  species                   String?
  yearOfStudy               String?
  yearStart                 Int?
  yearEnd                   Int?
  country                   String?
  title                     String?
  links                     String?
  epidemiologicalDisease    String?
  methodOfExtraction        String?
  relatedHosts              String?
  epidemiologicalIncidences String?

  @@index([species])
  @@index([country])
  @@index([epidemiologicalDisease])
  @@map("epidemiological_records")
}
